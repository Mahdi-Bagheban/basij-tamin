# درگاه پرداخت گروه جهادی بسیج — نرمال‌سازی پایان خط
# Basij payment portal — line-ending normalization

# Force LF for text sources — اجبار LF برای فایل‌های متنی
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf

# Keep binaries untouched — فایل‌های باینری دست‌نخورده بمانند
*.woff2 binary
*.png   binary
*.webp  binary
*.lottie binary
